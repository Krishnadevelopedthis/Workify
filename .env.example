# Workify settings. Everything is optional; DEPLOY.md explains each variable.
# Development: copy to .env.local.  docker compose: copy to .env (chmod 600).
# Never commit the copy with real values.

# --- docker compose only: your domain (DNS A record -> this server) ---
DOMAIN=workify.example.com

# --- Site ---
# Public URL for emailed links, canonical links and the sitemap. Build time:
# rebuild after changing. docker compose sets it from DOMAIN.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string (openssl rand -base64 32). Unset: data/secret.key is used.
WORKIFY_SECRET=

# --- Admins: comma-separated emails (account must exist and be verified) ---
WORKIFY_ADMIN_EMAILS=

# --- Email (SMTP). Without SMTP_HOST, emails stay in the admin outbox. ---
# Gmail: smtp.gmail.com, 587, your address, an app password.
# Brevo: smtp-relay.brevo.com, 587, SMTP login, SMTP key.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (the default there), false for STARTTLS on 587.
SMTP_SECURE=
SMTP_USER=
# Quote values containing $ with single quotes for docker compose.
SMTP_PASS=
# Sender, e.g. Workify <you@gmail.com> (default: Workify <no-reply@your-host>).
MAIL_FROM=

# --- Digital seal: your own .p12/.pfx (default: a self-signed one in data/signing) ---
WORKIFY_SIGN_P12=
WORKIFY_SIGN_P12_PASSWORD=

# --- Backups: daily database copies kept in data/backups ---
WORKIFY_BACKUP_KEEP=14

# --- Proxy and limits ---
WORKIFY_TRUST_PROXY=1
WORKIFY_MAX_JOBS=4
WORKIFY_MAX_QUEUE=20
WORKIFY_PROCESS_GLOBAL_LIMIT=6000
WORKIFY_PY_WORKERS=2
# Memory cap of the app container (docker-compose.yml). Raise on big servers.
# WORKIFY_MEM_LIMIT=3g

# --- PDF engines: only if not found automatically (see /admin/system) ---
# WORKIFY_GS=
# WORKIFY_QPDF=
# WORKIFY_SOFFICE=
# WORKIFY_TESSERACT=
# WORKIFY_TESSDATA=
# WORKIFY_PYTHON=
# WORKIFY_CHROME=
# Last resort only, on hosts that cannot allow user namespaces (DEPLOY.md,
# "Chromium sandbox"): turns off Chromium's renderer isolation for pages
# chosen by anyone. The Docker image does not set it.
# WORKIFY_CHROME_NO_SANDBOX=1

# --- Google Drive / Dropbox buttons (CLOUD_SETUP.md). Build time. ---
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_DROPBOX_APP_KEY=
