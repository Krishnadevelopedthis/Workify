{$DOMAIN} {
	encode zstd gzip
	# Uploads can be up to 500 MB per task.
	request_body {
		max_size 520MB
	}
	reverse_proxy app:3000 {
		# Large conversions can take a few minutes.
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
		# Caddy replaces X-Forwarded-For with the address that connected to it,
		# which is what the app's rate limits need (WORKIFY_TRUST_PROXY=1).
		# Behind Cloudflare that address is a Cloudflare server, so every visitor
		# would share its limits. Then uncomment the line below (current ranges:
		# https://www.cloudflare.com/ips/) and set WORKIFY_TRUST_PROXY=2 in
		# docker-compose.yml. Never trust ranges of a proxy you do not use.
		# trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
